# block67 environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to version control.

# Your RPC provider URL (Alchemy, Infura, QuickNode, or any JSON-RPC endpoint)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer wallet private key (64-character hex, with or without 0x prefix)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE

# Optional: set to 1 to see full stack traces on errors
# BLOCK67_DEBUG=1

# Optional: Anthropic API key for AI-powered error diagnostics
# ANTHROPIC_API_KEY=your_key_here
